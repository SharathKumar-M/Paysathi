# Optional: enables screenshot text extraction and more flexible Saathi wording.
# Core safety rules and all demo APIs work without this key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local SQLite file used only for anonymous Scam Gym progress.
PAYSAATHI_DB_PATH=./data/paysaathi.db

# Comma-separated frontend origins for local dev. Add your deployed frontend URL here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
